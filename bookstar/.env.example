NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Tellbirr Superapp Configuration
TELLBIRR_API_URL=https://api.tellbirr.com
TELLBIRR_API_KEY=your_api_key_here
TELLBIRR_APP_ID=your_app_id_here
